# R / RStudio
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# データと出力はGit管理対象外（フォルダ自体は .gitkeep で保持）
# 実際のオファー・市場データ・銘柄属性・出力Excelはここに置く
/data/*
!/data/.gitkeep
/output/*
!/output/.gitkeep
# 個人用の設定・一時ファイル（tmp/.Renviron など）
/tmp/*
!/tmp/.gitkeep

# Quarto の生成物（HTML・補助フォルダ・作業ファイル）。QMD本体は管理対象
*.html
*_files/
.quarto/
/.quarto/
*.knit.md
*.rmarkdown

# APIキー・認証情報（環境変数や個人用設定に置き、コミットしない）
.Renviron
.env
*.env
*.pem
*.key
*credential*
*secret*
config/*_local.R
config/*.local.*

# 一時ファイル
~$*
*.tmp
*.bak
.DS_Store
Thumbs.db
